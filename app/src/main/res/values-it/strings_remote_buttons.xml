<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Tasti del telecomando</string>
    <string name="remote_buttons_section_desc">Assegna una funzione ai tasti del telecomando durante la visione.</string>
    <string name="remote_buttons_intro">Ogni tasto può avere una funzione per la pressione e una per la pressione lunga. OK, Sinistra, Destra e Indietro mantengono sempre la loro funzione abituale. Su e Giù possono avere una funzione per quando i controlli del player sono nascosti. Il volume resta gestito dal box o dalla TV.</string>
    <string name="remote_buttons_setup_title">Configura un tasto</string>
    <string name="remote_buttons_setup_subtitle">Premilo o tienilo premuto sul telecomando, poi scegli la sua funzione</string>
    <string name="remote_buttons_reset">Ripristina tutti i tasti</string>
    <string name="remote_buttons_mapper_note">Usi tvQuickActions o Button Mapper? Imposta lì il tuo pulsante per inviare un tasto, per esempio Rosso o Info, poi scegli qui la funzione di quel tasto.</string>
    <string name="remote_buttons_hold_note">La pressione lunga funziona quando il box passa all\'app il tasto tenuto premuto. Se in Configura un tasto non compare mai una pressione lunga, su questo box quel tasto ha solo una funzione per la pressione.</string>
    <string name="remote_buttons_number_keys">Tasti numerici</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = metà, 0 = inizio</string>
    <string name="remote_buttons_added">Configurato su questo box</string>
    <string name="remote_buttons_up_down_row">Mentre i controlli sono nascosti</string>
    <string name="remote_buttons_up_down_desc">Solo mentre i controlli del player sono nascosti. Con i controlli visibili, Su e Giù si spostano tra di essi come al solito.</string>
    <string name="remote_buttons_learn_title">Configura un tasto</string>
    <string name="remote_buttons_learn_subtitle">Premi sul telecomando il tasto a cui vuoi dare una funzione. Tienilo premuto per impostare invece la sua funzione per la pressione lunga. Indietro annulla.</string>
    <string name="remote_buttons_learn_waiting">In attesa di un tasto…</string>
    <string name="remote_buttons_learn_let_go">Pressione lunga rilevata. Rilascia il tasto.</string>
    <string name="remote_buttons_learn_nothing">Non è ancora arrivato nulla. Alcuni tasti, come Home, il microfono, il volume e i tasti Netflix o YouTube, appartengono al box e non raggiungono mai l\'app. Se usi il telecomando della TV, la TV potrebbe non passare questo tasto al box. Prova un altro tasto, oppure liberalo con un\'app di rimappatura come tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: non modificabile. OK, Sinistra, Destra e Indietro mantengono sempre la loro funzione abituale, così nessuno resta bloccato nel player. Premi un altro tasto.</string>
    <string name="remote_buttons_learn_volume">Il volume resta gestito dal box o dalla TV. Premi un altro tasto.</string>

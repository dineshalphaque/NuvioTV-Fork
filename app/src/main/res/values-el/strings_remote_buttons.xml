<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Κουμπιά τηλεχειριστηρίου</string>
    <string name="remote_buttons_section_desc">Δώστε λειτουργίες στα κουμπιά του τηλεχειριστηρίου κατά την προβολή.</string>
    <string name="remote_buttons_intro">Κάθε κουμπί μπορεί να έχει μια λειτουργία πατήματος και μια λειτουργία παρατεταμένου πατήματος. Τα OK, Αριστερά, Δεξιά και Πίσω κρατούν πάντα τις συνήθεις λειτουργίες τους. Τα Πάνω και Κάτω μπορούν να πάρουν λειτουργία για όταν τα χειριστήρια αναπαραγωγής είναι κρυμμένα. Την ένταση την ελέγχει η συσκευή ή η τηλεόραση.</string>
    <string name="remote_buttons_setup_title">Ρύθμιση κουμπιού</string>
    <string name="remote_buttons_setup_subtitle">Πατήστε το ή κρατήστε το πατημένο στο τηλεχειριστήριο και επιλέξτε λειτουργία</string>
    <string name="remote_buttons_reset">Επαναφορά όλων των κουμπιών</string>
    <string name="remote_buttons_mapper_note">Χρησιμοποιείτε tvQuickActions ή Button Mapper; Ρυθμίστε εκεί το κουμπί να στέλνει ένα πλήκτρο, για παράδειγμα Κόκκινο ή Πληροφορίες, και μετά επιλέξτε εδώ τη λειτουργία αυτού του πλήκτρου.</string>
    <string name="remote_buttons_hold_note">Το παρατεταμένο πάτημα λειτουργεί όταν η συσκευή προωθεί το πατημένο κουμπί στην εφαρμογή. Αν δεν εμφανίζεται ποτέ παρατεταμένο πάτημα στη Ρύθμιση κουμπιού, αυτό το κουμπί έχει μόνο λειτουργία πατήματος σε αυτή τη συσκευή.</string>
    <string name="remote_buttons_number_keys">Αριθμητικά πλήκτρα</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = μέση, 0 = αρχή</string>
    <string name="remote_buttons_added">Ρυθμίστηκε σε αυτή τη συσκευή</string>
    <string name="remote_buttons_up_down_row">Όσο τα χειριστήρια είναι κρυμμένα</string>
    <string name="remote_buttons_up_down_desc">Μόνο όσο τα χειριστήρια αναπαραγωγής είναι κρυμμένα. Όταν τα χειριστήρια εμφανίζονται, τα Πάνω και Κάτω μετακινούνται σε αυτά όπως συνήθως.</string>
    <string name="remote_buttons_learn_title">Ρύθμιση κουμπιού</string>
    <string name="remote_buttons_learn_subtitle">Πατήστε στο τηλεχειριστήριο το κουμπί που θέλετε να ρυθμίσετε. Κρατήστε το πατημένο για να ορίσετε τη λειτουργία παρατεταμένου πατήματός του. Το Πίσω ακυρώνει.</string>
    <string name="remote_buttons_learn_waiting">Αναμονή για κουμπί…</string>
    <string name="remote_buttons_learn_let_go">Εντοπίστηκε παρατεταμένο πάτημα. Αφήστε το κουμπί.</string>
    <string name="remote_buttons_learn_nothing">Δεν έφτασε τίποτα ακόμη. Ορισμένα κουμπιά, όπως το κουμπί Αρχική, το μικρόφωνο, η ένταση και τα κουμπιά Netflix ή YouTube, ανήκουν στη συσκευή και δεν φτάνουν ποτέ στην εφαρμογή. Αν χρησιμοποιείτε το τηλεχειριστήριο της τηλεόρασης, η τηλεόραση ίσως να μην προωθεί αυτό το κουμπί στη συσκευή. Δοκιμάστε άλλο κουμπί ή ελευθερώστε αυτό με μια εφαρμογή αντιστοίχισης κουμπιών, όπως το tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: δεν αλλάζει. Τα OK, Αριστερά, Δεξιά και Πίσω κρατούν πάντα τις συνήθεις λειτουργίες τους, ώστε κανείς να μην κολλήσει στην αναπαραγωγή. Πατήστε άλλο κουμπί.</string>
    <string name="remote_buttons_learn_volume">Την ένταση την ελέγχει η συσκευή ή η τηλεόραση. Πατήστε άλλο κουμπί.</string>

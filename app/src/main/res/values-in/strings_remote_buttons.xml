<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Tombol remote</string>
    <string name="remote_buttons_section_desc">Beri tombol remote sebuah fungsi saat menonton.</string>
    <string name="remote_buttons_intro">Setiap tombol bisa punya fungsi tekan dan fungsi tahan. OK, Kiri, Kanan, dan Kembali selalu mempertahankan fungsi biasanya. Atas dan Bawah bisa diberi fungsi untuk saat kontrol pemutar tersembunyi. Volume tetap diatur oleh perangkat atau TV Anda.</string>
    <string name="remote_buttons_setup_title">Atur tombol</string>
    <string name="remote_buttons_setup_subtitle">Tekan atau tahan tombolnya di remote, lalu pilih fungsinya</string>
    <string name="remote_buttons_reset">Reset semua tombol</string>
    <string name="remote_buttons_mapper_note">Memakai tvQuickActions atau Button Mapper? Di sana, atur tombol Anda agar mengirim tombol lain, misalnya Merah atau Info, lalu pilih fungsi tombol itu di sini.</string>
    <string name="remote_buttons_hold_note">Tahan berfungsi jika perangkat Anda meneruskan tombol yang ditahan ke aplikasi. Jika tahan tidak pernah muncul di Atur tombol, tombol itu hanya punya fungsi tekan di perangkat ini.</string>
    <string name="remote_buttons_number_keys">Tombol angka</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = tengah, 0 = awal</string>
    <string name="remote_buttons_added">Diatur di perangkat ini</string>
    <string name="remote_buttons_up_down_row">Saat kontrol tersembunyi</string>
    <string name="remote_buttons_up_down_desc">Hanya saat kontrol pemutar tersembunyi. Saat kontrol terlihat, Atas dan Bawah berpindah di antaranya seperti biasa.</string>
    <string name="remote_buttons_learn_title">Atur tombol</string>
    <string name="remote_buttons_learn_subtitle">Tekan tombol di remote yang ingin Anda beri fungsi. Tahan untuk mengatur fungsi tahannya. Tekan Kembali untuk membatalkan.</string>
    <string name="remote_buttons_learn_waiting">Menunggu tombol…</string>
    <string name="remote_buttons_learn_let_go">Tahan terdeteksi. Lepaskan tombolnya.</string>
    <string name="remote_buttons_learn_nothing">Belum ada yang masuk. Beberapa tombol, seperti Beranda, mikrofon, volume, dan tombol Netflix atau YouTube, milik perangkat Anda dan tidak pernah sampai ke aplikasi. Jika Anda memakai remote TV, TV Anda mungkin tidak meneruskan tombol ini ke perangkat. Coba tombol lain, atau bebaskan tombol itu dengan aplikasi pemeta tombol seperti tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s tidak bisa diubah. OK, Kiri, Kanan, dan Kembali selalu mempertahankan fungsi biasanya, agar tidak ada yang terjebak di pemutar. Tekan tombol lain.</string>
    <string name="remote_buttons_learn_volume">Volume tetap diatur oleh perangkat atau TV Anda. Tekan tombol lain.</string>

<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Gumbi daljinca</string>
    <string name="remote_buttons_section_desc">Gumbom daljinca med gledanjem dodelite funkcije.</string>
    <string name="remote_buttons_intro">Vsak gumb ima lahko funkcijo ob pritisku in funkcijo ob držanju. OK, Levo, Desno in Nazaj vedno ohranijo svoje običajne funkcije. Gor in Dol lahko dobita funkcijo za čas, ko so kontrolniki predvajalnika skriti. Glasnost še naprej upravlja naprava ali televizor.</string>
    <string name="remote_buttons_setup_title">Nastavi gumb</string>
    <string name="remote_buttons_setup_subtitle">Pritisnite ga ali ga zadržite na daljincu, nato izberite njegovo funkcijo</string>
    <string name="remote_buttons_reset">Ponastavi vse gumbe</string>
    <string name="remote_buttons_mapper_note">Uporabljate tvQuickActions ali Button Mapper? Tam nastavite gumb, da pošlje tipko, na primer Rdeča ali Info, nato tukaj izberite funkcijo te tipke.</string>
    <string name="remote_buttons_hold_note">Držanje deluje, ko naprava posreduje zadržani gumb aplikaciji. Če se v Nastavi gumb držanje nikoli ne pokaže, ima ta gumb na tej napravi le funkcijo ob pritisku.</string>
    <string name="remote_buttons_number_keys">Številske tipke</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = polovica, 0 = začetek</string>
    <string name="remote_buttons_added">Nastavljen na tej napravi</string>
    <string name="remote_buttons_up_down_row">Ko so kontrolniki skriti</string>
    <string name="remote_buttons_up_down_desc">Le ko so kontrolniki predvajalnika skriti. Ko so kontrolniki prikazani, se Gor in Dol po njih premikata kot običajno.</string>
    <string name="remote_buttons_learn_title">Nastavi gumb</string>
    <string name="remote_buttons_learn_subtitle">Na daljincu pritisnite gumb, ki mu želite dodeliti funkcijo. Zadržite ga, da nastavite funkcijo ob držanju. Nazaj prekliče.</string>
    <string name="remote_buttons_learn_waiting">Čakanje na gumb…</string>
    <string name="remote_buttons_learn_let_go">Zaznano držanje. Spustite gumb.</string>
    <string name="remote_buttons_learn_nothing">Nič še ni prispelo. Nekateri gumbi, na primer Home, mikrofon, glasnost ter gumba Netflix in YouTube, pripadajo napravi in nikoli ne dosežejo aplikacije. Če uporabljate daljinec televizorja, televizor tega gumba morda ne posreduje napravi. Poskusite drug gumb ali tega sprostite z aplikacijo za preslikavo gumbov, kot je tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: ni mogoče spremeniti. OK, Levo, Desno in Nazaj vedno ohranijo svoje običajne funkcije, da se nihče ne zatakne v predvajalniku. Pritisnite drug gumb.</string>
    <string name="remote_buttons_learn_volume">Glasnost še naprej upravlja naprava ali televizor. Pritisnite drug gumb.</string>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Knoppen afstandsbediening</string>
    <string name="remote_buttons_section_desc">Geef knoppen op je afstandsbediening een functie tijdens het kijken.</string>
    <string name="remote_buttons_intro">Elke knop kan een functie voor drukken en een voor lang indrukken hebben. OK, Links, Rechts en Terug houden altijd hun gewone functie. Omhoog en Omlaag kunnen een functie krijgen voor wanneer de bediening van de speler verborgen is. Het volume wordt nog steeds door je box of tv geregeld.</string>
    <string name="remote_buttons_setup_title">Knop instellen</string>
    <string name="remote_buttons_setup_subtitle">Druk erop of houd hem ingedrukt op je afstandsbediening en kies dan de functie</string>
    <string name="remote_buttons_reset">Alle knoppen resetten</string>
    <string name="remote_buttons_mapper_note">Gebruik je tvQuickActions of Button Mapper? Laat je knop daar een toets sturen, bijvoorbeeld Rood of Info, en kies hier de functie van die toets.</string>
    <string name="remote_buttons_hold_note">Lang indrukken werkt als je box de ingedrukte knop doorgeeft aan de app. Verschijnt er in Knop instellen nooit een lang indrukken, dan heeft die knop op deze box alleen een functie voor drukken.</string>
    <string name="remote_buttons_number_keys">Cijfertoetsen</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = halverwege, 0 = begin</string>
    <string name="remote_buttons_added">Ingesteld op deze box</string>
    <string name="remote_buttons_up_down_row">Terwijl de bediening verborgen is</string>
    <string name="remote_buttons_up_down_desc">Alleen terwijl de bediening van de speler verborgen is. Als de bediening zichtbaar is, navigeren Omhoog en Omlaag er zoals gewoonlijk doorheen.</string>
    <string name="remote_buttons_learn_title">Knop instellen</string>
    <string name="remote_buttons_learn_subtitle">Druk op de knop op je afstandsbediening die een functie moet krijgen. Houd hem ingedrukt om in plaats daarvan de functie voor lang indrukken in te stellen. Terug annuleert.</string>
    <string name="remote_buttons_learn_waiting">Wachten op een knop…</string>
    <string name="remote_buttons_learn_let_go">Lang indrukken herkend. Laat de knop los.</string>
    <string name="remote_buttons_learn_nothing">Nog niets ontvangen. Sommige knoppen, zoals Home, de microfoon, het volume en de Netflix- of YouTube-knop, horen bij je box en bereiken de app nooit. Gebruik je de afstandsbediening van je tv, dan geeft je tv deze knop misschien niet door aan de box. Probeer een andere knop, of maak deze vrij met een button-mapper-app zoals tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: niet te wijzigen. OK, Links, Rechts en Terug houden altijd hun gewone functie, zodat niemand vastzit in de speler. Druk op een andere knop.</string>
    <string name="remote_buttons_learn_volume">Het volume wordt nog steeds door je box of tv geregeld. Druk op een andere knop.</string>
    <string name="remote_buttons_press">Drukken</string>

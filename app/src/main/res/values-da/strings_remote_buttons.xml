<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Fjernbetjeningsknapper</string>
    <string name="remote_buttons_section_desc">Giv knapperne på fjernbetjeningen en funktion, mens du ser.</string>
    <string name="remote_buttons_intro">Hver knap kan have en funktion for tryk og en for langt tryk. OK, Venstre, Højre og Tilbage beholder altid deres normale funktion. Op og Ned kan få en funktion til, når afspillerens kontroller er skjult. Lydstyrken styres stadig af din boks eller dit tv.</string>
    <string name="remote_buttons_setup_title">Opsæt en knap</string>
    <string name="remote_buttons_setup_subtitle">Tryk på den eller hold den inde på fjernbetjeningen, og vælg så dens funktion</string>
    <string name="remote_buttons_reset">Nulstil alle knapper</string>
    <string name="remote_buttons_mapper_note">Bruger du tvQuickActions eller Button Mapper? Indstil din knap dér til at sende en tast, for eksempel Rød eller Info, og vælg så tastens funktion her.</string>
    <string name="remote_buttons_hold_note">Langt tryk virker, når din boks sender den holdte knap videre til appen. Dukker et langt tryk aldrig op i Opsæt en knap, har den knap kun en funktion for tryk på denne boks.</string>
    <string name="remote_buttons_number_keys">Taltaster</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = halvvejs, 0 = start</string>
    <string name="remote_buttons_added">Opsat på denne boks</string>
    <string name="remote_buttons_up_down_row">Mens kontrollerne er skjult</string>
    <string name="remote_buttons_up_down_desc">Kun mens afspillerens kontroller er skjult. Når kontrollerne vises, flytter Op og Ned rundt i dem som normalt.</string>
    <string name="remote_buttons_learn_title">Opsæt en knap</string>
    <string name="remote_buttons_learn_subtitle">Tryk på den knap på fjernbetjeningen, du vil give en funktion. Hold den inde for i stedet at sætte dens funktion for langt tryk. Tilbage annullerer.</string>
    <string name="remote_buttons_learn_waiting">Venter på en knap…</string>
    <string name="remote_buttons_learn_let_go">Langt tryk registreret. Slip knappen.</string>
    <string name="remote_buttons_learn_nothing">Intet modtaget endnu. Nogle knapper, som Hjem, mikrofonen, lydstyrken og Netflix- eller YouTube-knappen, hører til din boks og når aldrig frem til appen. Bruger du fjernbetjeningen til dit tv, sender dit tv måske ikke knappen videre til boksen. Prøv en anden knap, eller frigør den med en button-mapper-app som tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s kan ikke ændres. OK, Venstre, Højre og Tilbage beholder altid deres normale funktion, så ingen sidder fast i afspilleren. Tryk på en anden knap.</string>
    <string name="remote_buttons_learn_volume">Lydstyrken styres stadig af din boks eller dit tv. Tryk på en anden knap.</string>

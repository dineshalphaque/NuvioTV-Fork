<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">リモコンボタン</string>
    <string name="remote_buttons_section_desc">視聴中のリモコンボタンに機能を割り当てます。</string>
    <string name="remote_buttons_intro">どのボタンにも短押しの機能と長押しの機能を設定できます。OK、左、右、戻るはいつもの機能のままです。上と下には、プレーヤーのコントロールが隠れているときの機能を割り当てられます。音量はデバイスまたはテレビ側で操作します。</string>
    <string name="remote_buttons_setup_title">ボタンを設定</string>
    <string name="remote_buttons_setup_subtitle">リモコンでボタンを押すか長押ししてから、機能を選んでください</string>
    <string name="remote_buttons_reset">すべてのボタンをリセット</string>
    <string name="remote_buttons_mapper_note">tvQuickActions や Button Mapper をお使いですか？そちらでボタンが「赤」や「情報」などのキーを送るように設定し、ここでそのキーの機能を選んでください。</string>
    <string name="remote_buttons_hold_note">長押しは、デバイスが長押ししたボタンをアプリに渡す場合に使えます。「ボタンを設定」で長押しが一度も検出されない場合、このデバイスではそのボタンに短押しの機能しか設定できません。</string>
    <string name="remote_buttons_number_keys">数字キー</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %、5 = 中間、0 = 最初</string>
    <string name="remote_buttons_added">このデバイスで設定済み</string>
    <string name="remote_buttons_up_down_row">コントロールが隠れているとき</string>
    <string name="remote_buttons_up_down_desc">プレーヤーのコントロールが隠れているときだけ有効です。コントロールの表示中は、上と下でいつもどおりコントロール内を移動します。</string>
    <string name="remote_buttons_learn_title">ボタンを設定</string>
    <string name="remote_buttons_learn_subtitle">機能を割り当てたいリモコンのボタンを押してください。長押しすると、代わりに長押しの機能を設定します。戻るでキャンセルします。</string>
    <string name="remote_buttons_learn_waiting">ボタンを待っています…</string>
    <string name="remote_buttons_learn_let_go">長押しを検出しました。ボタンから指を離してください。</string>
    <string name="remote_buttons_learn_nothing">まだ何も届いていません。ホーム、マイク、音量、Netflix や YouTube ボタンなど一部のボタンはデバイス側で使われ、アプリには届きません。テレビのリモコンを使っている場合、テレビがこのボタンをデバイスに渡さないことがあります。別のボタンを試すか、tvQuickActions などのボタン割り当てアプリでそのボタンを使えるようにしてください。</string>
    <string name="remote_buttons_learn_locked">「%1$s」は変更できません。OK、左、右、戻るは常にいつもの機能のままなので、プレーヤーから抜け出せなくなることはありません。別のボタンを押してください。</string>
    <string name="remote_buttons_learn_volume">音量はデバイスまたはテレビ側で操作します。別のボタンを押してください。</string>

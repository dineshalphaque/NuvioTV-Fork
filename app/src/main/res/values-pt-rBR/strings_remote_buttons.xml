<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Botões do controle</string>
    <string name="remote_buttons_section_desc">Dê uma função aos botões do controle enquanto assiste.</string>
    <string name="remote_buttons_intro">Cada botão pode ter uma função ao pressionar e uma função ao segurar. OK, Esquerda, Direita e Voltar sempre mantêm suas funções normais. Cima e Baixo podem ter uma função para quando os controles do player estão ocultos. O volume continua sendo controlado pelo aparelho ou pela TV.</string>
    <string name="remote_buttons_setup_title">Configurar um botão</string>
    <string name="remote_buttons_setup_subtitle">Pressione-o ou segure-o no controle e escolha a função dele</string>
    <string name="remote_buttons_reset">Redefinir todos os botões</string>
    <string name="remote_buttons_mapper_note">Usa o tvQuickActions ou o Button Mapper? Configure lá o botão para enviar uma tecla, por exemplo Vermelho ou Info, e escolha aqui a função dessa tecla.</string>
    <string name="remote_buttons_hold_note">Segurar funciona quando o aparelho repassa o botão segurado ao app. Se, em Configurar um botão, um toque longo nunca é detectado, neste aparelho esse botão só tem função ao pressionar.</string>
    <string name="remote_buttons_number_keys">Teclas numéricas</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = metade, 0 = início</string>
    <string name="remote_buttons_added">Configurado neste aparelho</string>
    <string name="remote_buttons_up_down_row">Com os controles ocultos</string>
    <string name="remote_buttons_up_down_desc">Só enquanto os controles do player estão ocultos. Com os controles visíveis, Cima e Baixo navegam por eles como de costume.</string>
    <string name="remote_buttons_learn_title">Configurar um botão</string>
    <string name="remote_buttons_learn_subtitle">Pressione no controle o botão ao qual quer dar uma função. Segure-o para definir a função ao segurar. Voltar cancela.</string>
    <string name="remote_buttons_learn_waiting">Aguardando um botão…</string>
    <string name="remote_buttons_learn_let_go">Toque longo detectado. Solte o botão.</string>
    <string name="remote_buttons_learn_nothing">Nada chegou ainda. Alguns botões, como Home, o microfone, o volume e os botões Netflix ou YouTube, pertencem ao aparelho e nunca chegam ao app. Se você usa o controle da TV, a TV pode não repassar esse botão ao aparelho. Tente outro botão ou libere esse com um app de mapeamento de botões, como o tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: não é possível alterar. OK, Esquerda, Direita e Voltar sempre mantêm suas funções normais, para ninguém ficar preso no player. Pressione outro botão.</string>
    <string name="remote_buttons_learn_volume">O volume continua sendo controlado pelo aparelho ou pela TV. Pressione outro botão.</string>

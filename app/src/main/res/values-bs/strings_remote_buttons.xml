<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Dugmad daljinskog</string>
    <string name="remote_buttons_section_desc">Dodijeli funkcije dugmadi daljinskog dok gledaš.</string>
    <string name="remote_buttons_intro">Svako dugme može imati funkciju na pritisak i funkciju na držanje. OK, „Lijevo“, „Desno“ i „Nazad“ uvijek zadržavaju svoje uobičajene funkcije. „Gore“ i „Dolje“ mogu dobiti funkciju za vrijeme dok su kontrole playera skrivene. Jačinom zvuka upravlja uređaj ili televizor.</string>
    <string name="remote_buttons_setup_title">Postavi dugme</string>
    <string name="remote_buttons_setup_subtitle">Pritisni ga ili ga drži na daljinskom, zatim odaberi njegovu funkciju</string>
    <string name="remote_buttons_reset">Resetuj svu dugmad</string>
    <string name="remote_buttons_mapper_note">Koristiš tvQuickActions ili Button Mapper? Tamo podesi dugme da šalje tipku, na primjer „Crveno“ ili „Info“, pa ovdje odaberi funkciju te tipke.</string>
    <string name="remote_buttons_hold_note">Držanje radi kad uređaj prosljeđuje držano dugme aplikaciji. Ako se držanje nikad ne pojavi u „Postavi dugme“, to dugme na ovom uređaju ima samo funkciju na pritisak.</string>
    <string name="remote_buttons_number_keys">Dugmad s brojevima</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = polovina, 0 = početak</string>
    <string name="remote_buttons_added">Postavljeno na ovom uređaju</string>
    <string name="remote_buttons_up_down_row">Dok su kontrole skrivene</string>
    <string name="remote_buttons_up_down_desc">Samo dok su kontrole playera skrivene. Kad su kontrole prikazane, „Gore“ i „Dolje“ se kreću po njima kao i obično.</string>
    <string name="remote_buttons_learn_title">Postavi dugme</string>
    <string name="remote_buttons_learn_subtitle">Pritisni dugme na daljinskom kojem želiš dodijeliti funkciju. Drži ga da umjesto toga postaviš njegovu funkciju na držanje. „Nazad“ otkazuje.</string>
    <string name="remote_buttons_learn_waiting">Čekam dugme…</string>
    <string name="remote_buttons_learn_let_go">Držanje prepoznato. Pusti dugme.</string>
    <string name="remote_buttons_learn_nothing">Još ništa nije stiglo. Neka dugmad, kao što su „Početna“, mikrofon, jačina zvuka i dugmad Netflix ili YouTube, pripadaju uređaju i nikad ne stignu do aplikacije. Ako koristiš daljinski od televizora, televizor možda ne prosljeđuje ovo dugme uređaju. Probaj drugo dugme ili oslobodi ovo pomoću aplikacije za mapiranje dugmadi, kao što je tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: ne može se promijeniti. OK, „Lijevo“, „Desno“ i „Nazad“ uvijek zadržavaju svoje uobičajene funkcije, da niko ne zaglavi u playeru. Pritisni drugo dugme.</string>
    <string name="remote_buttons_learn_volume">Jačinom zvuka upravlja uređaj ili televizor. Pritisni drugo dugme.</string>

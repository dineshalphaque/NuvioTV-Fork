    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Távirányító gombjai</string>
    <string name="remote_buttons_section_desc">Adj funkciót a távirányító gombjainak nézés közben.</string>
    <string name="remote_buttons_intro">Minden gombnak lehet egy funkciója megnyomásra és egy nyomva tartásra. Az OK, a Balra, a Jobbra és a Vissza mindig megtartják a szokásos funkciójukat. A Fel és a Le kaphat funkciót arra az esetre, amikor a lejátszó vezérlői rejtve vannak. A hangerőt továbbra is az eszköz vagy a tévé kezeli.</string>
    <string name="remote_buttons_setup_title">Gomb beállítása</string>
    <string name="remote_buttons_setup_subtitle">Nyomd meg vagy tartsd nyomva a távirányítón, majd válassz neki funkciót</string>
    <string name="remote_buttons_reset">Összes gomb visszaállítása</string>
    <string name="remote_buttons_mapper_note">tvQuickActions-t vagy Button Mappert használsz? Ott állítsd be, hogy a gomb egy billentyűt küldjön, például a Pirosat vagy az Infót, majd itt válaszd ki annak a billentyűnek a funkcióját.</string>
    <string name="remote_buttons_hold_note">A nyomva tartás akkor működik, ha az eszköz továbbadja a nyomva tartott gombot az alkalmazásnak. Ha a Gomb beállítása sosem érzékel nyomva tartást, annak a gombnak ezen az eszközön csak megnyomásra van funkciója.</string>
    <string name="remote_buttons_number_keys">Számgombok</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = fele, 0 = eleje</string>
    <string name="remote_buttons_added">Ezen az eszközön beállítva</string>
    <string name="remote_buttons_up_down_row">Amíg a vezérlők rejtve vannak</string>
    <string name="remote_buttons_up_down_desc">Csak amíg a lejátszó vezérlői rejtve vannak. Ha a vezérlők látszanak, a Fel és a Le a szokásos módon mozog köztük.</string>
    <string name="remote_buttons_learn_title">Gomb beállítása</string>
    <string name="remote_buttons_learn_subtitle">Nyomd meg a távirányítón azt a gombot, amelynek funkciót szeretnél adni. Tartsd nyomva, ha a nyomva tartás funkcióját állítanád be. A Vissza megszakítja.</string>
    <string name="remote_buttons_learn_waiting">Várakozás egy gombra…</string>
    <string name="remote_buttons_learn_let_go">Nyomva tartás érzékelve. Engedd el a gombot.</string>
    <string name="remote_buttons_learn_nothing">Még nem érkezett semmi. Egyes gombok, például a Home, a mikrofon, a hangerő és a Netflix vagy YouTube gomb, az eszközhöz tartoznak, és sosem jutnak el az alkalmazásig. Ha a tévé távirányítóját használod, lehet, hogy a tévé nem adja tovább ezt a gombot az eszköznek. Próbálj másik gombot, vagy szabadítsd fel azt egy gombkiosztó alkalmazással, például a tvQuickActions-szel.</string>
    <string name="remote_buttons_learn_locked">%1$s: nem módosítható. Az OK, a Balra, a Jobbra és a Vissza mindig megtartják a szokásos funkciójukat, hogy senki ne ragadjon bent a lejátszóban. Nyomj meg egy másik gombot.</string>
    <string name="remote_buttons_learn_volume">A hangerőt továbbra is az eszköz vagy a tévé kezeli. Nyomj meg egy másik gombot.</string>

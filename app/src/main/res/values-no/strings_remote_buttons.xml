<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Fjernkontrollknapper</string>
    <string name="remote_buttons_section_desc">Gi knappene på fjernkontrollen en funksjon mens du ser.</string>
    <string name="remote_buttons_intro">Hver knapp kan ha en funksjon for trykk og en for langt trykk. OK, Venstre, Høyre og Tilbake beholder alltid sine vanlige funksjoner. Opp og Ned kan få en funksjon for når spillerens kontroller er skjult. Volumet styres fortsatt av boksen eller TV-en.</string>
    <string name="remote_buttons_setup_title">Sett opp en knapp</string>
    <string name="remote_buttons_setup_subtitle">Trykk på den eller hold den inne på fjernkontrollen, og velg så funksjon</string>
    <string name="remote_buttons_reset">Tilbakestill alle knapper</string>
    <string name="remote_buttons_mapper_note">Bruker du tvQuickActions eller Button Mapper? Still inn knappen der til å sende en tast, for eksempel Rød eller Info, og velg så tastens funksjon her.</string>
    <string name="remote_buttons_hold_note">Langt trykk virker når boksen sender knappen du holder inne, videre til appen. Dukker et langt trykk aldri opp i Sett opp en knapp, har den knappen bare en funksjon for trykk på denne boksen.</string>
    <string name="remote_buttons_number_keys">Talltaster</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = halvveis, 0 = start</string>
    <string name="remote_buttons_added">Satt opp på denne boksen</string>
    <string name="remote_buttons_up_down_row">Mens kontrollene er skjult</string>
    <string name="remote_buttons_up_down_desc">Bare mens spillerens kontroller er skjult. Når kontrollene vises, flytter Opp og Ned rundt i dem som vanlig.</string>
    <string name="remote_buttons_learn_title">Sett opp en knapp</string>
    <string name="remote_buttons_learn_subtitle">Trykk på knappen på fjernkontrollen som skal få en funksjon. Hold den inne for i stedet å sette funksjonen for langt trykk. Tilbake avbryter.</string>
    <string name="remote_buttons_learn_waiting">Venter på en knapp…</string>
    <string name="remote_buttons_learn_let_go">Langt trykk registrert. Slipp knappen.</string>
    <string name="remote_buttons_learn_nothing">Ingenting har kommet fram ennå. Noen knapper, som Hjem, mikrofonen, volumet og Netflix- eller YouTube-knappen, hører til boksen og når aldri appen. Bruker du fjernkontrollen til TV-en, sender kanskje ikke TV-en knappen videre til boksen. Prøv en annen knapp, eller frigjør den med en knappetilordningsapp som tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s kan ikke endres. OK, Venstre, Høyre og Tilbake beholder alltid sine vanlige funksjoner, så ingen blir sittende fast i spilleren. Trykk på en annen knapp.</string>
    <string name="remote_buttons_learn_volume">Volumet styres fortsatt av boksen eller TV-en. Trykk på en annen knapp.</string>

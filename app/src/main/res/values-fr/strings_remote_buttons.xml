<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Touches de la télécommande</string>
    <string name="remote_buttons_section_desc">Attribuez une fonction aux touches de la télécommande pendant la lecture.</string>
    <string name="remote_buttons_intro">Chaque touche peut avoir une fonction à l\'appui et une fonction à l\'appui long. OK, Gauche, Droite et Retour gardent toujours leur fonction habituelle. Haut et Bas peuvent recevoir une fonction pour quand les contrôles du lecteur sont masqués. Le volume reste géré par votre box ou votre téléviseur.</string>
    <string name="remote_buttons_setup_title">Configurer une touche</string>
    <string name="remote_buttons_setup_subtitle">Appuyez dessus ou maintenez-la sur la télécommande, puis choisissez sa fonction</string>
    <string name="remote_buttons_reset">Réinitialiser toutes les touches</string>
    <string name="remote_buttons_mapper_note">Vous utilisez tvQuickActions ou Button Mapper ? Réglez-y votre bouton pour envoyer une touche, par exemple Rouge ou Info, puis choisissez ici la fonction de cette touche.</string>
    <string name="remote_buttons_hold_note">L\'appui long fonctionne quand votre box transmet la touche maintenue à l\'application. Si aucun appui long n\'apparaît jamais dans Configurer une touche, cette touche n\'a qu\'une fonction à l\'appui sur cette box.</string>
    <string name="remote_buttons_number_keys">Touches numériques</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = moitié, 0 = début</string>
    <string name="remote_buttons_added">Configurée sur cette box</string>
    <string name="remote_buttons_up_down_row">Quand les contrôles sont masqués</string>
    <string name="remote_buttons_up_down_desc">Seulement quand les contrôles du lecteur sont masqués. Quand ils sont affichés, Haut et Bas s\'y déplacent comme d\'habitude.</string>
    <string name="remote_buttons_learn_title">Configurer une touche</string>
    <string name="remote_buttons_learn_subtitle">Appuyez sur la touche de la télécommande à laquelle attribuer une fonction. Maintenez-la pour définir plutôt sa fonction à l\'appui long. Retour annule.</string>
    <string name="remote_buttons_learn_waiting">En attente d\'une touche…</string>
    <string name="remote_buttons_learn_let_go">Appui long détecté. Relâchez la touche.</string>
    <string name="remote_buttons_learn_nothing">Rien reçu pour l\'instant. Certaines touches, comme Accueil, le micro, le volume et les touches Netflix ou YouTube, appartiennent à votre box et n\'atteignent jamais l\'application. Avec la télécommande du téléviseur, celui-ci peut ne pas transmettre cette touche à la box. Essayez une autre touche, ou libérez celle-ci avec une application de remappage comme tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s : non modifiable. OK, Gauche, Droite et Retour gardent toujours leur fonction habituelle, pour que personne ne reste bloqué dans le lecteur. Appuyez sur une autre touche.</string>
    <string name="remote_buttons_learn_volume">Le volume reste géré par votre box ou votre téléviseur. Appuyez sur une autre touche.</string>

<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Butoanele telecomenzii</string>
    <string name="remote_buttons_section_desc">Dă butoanelor telecomenzii o funcție în timp ce vizionezi.</string>
    <string name="remote_buttons_intro">Fiecare buton poate avea o funcție la apăsare și una la apăsare lungă. OK, Stânga, Dreapta și Înapoi își păstrează mereu funcțiile obișnuite. Sus și Jos pot primi o funcție pentru când controalele playerului sunt ascunse. Volumul rămâne controlat de dispozitiv sau de televizor.</string>
    <string name="remote_buttons_setup_title">Configurează un buton</string>
    <string name="remote_buttons_setup_subtitle">Apasă-l sau ține-l apăsat pe telecomandă, apoi alege-i funcția</string>
    <string name="remote_buttons_reset">Resetează toate butoanele</string>
    <string name="remote_buttons_mapper_note">Folosești tvQuickActions sau Button Mapper? Setează acolo butonul să trimită o tastă, de exemplu Roșu sau Info, apoi alege aici funcția acelei taste.</string>
    <string name="remote_buttons_hold_note">Apăsarea lungă funcționează când dispozitivul transmite aplicației butonul ținut apăsat. Dacă în Configurează un buton nu apare niciodată o apăsare lungă, pe acest dispozitiv butonul are doar funcție la apăsare.</string>
    <string name="remote_buttons_number_keys">Taste numerice</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = jumătate, 0 = început</string>
    <string name="remote_buttons_added">Configurat pe acest dispozitiv</string>
    <string name="remote_buttons_up_down_row">Cât timp controalele sunt ascunse</string>
    <string name="remote_buttons_up_down_desc">Doar cât timp controalele playerului sunt ascunse. Când controalele sunt afișate, Sus și Jos navighează prin ele ca de obicei.</string>
    <string name="remote_buttons_learn_title">Configurează un buton</string>
    <string name="remote_buttons_learn_subtitle">Apasă pe telecomandă butonul căruia vrei să-i dai o funcție. Ține-l apăsat pentru a-i seta funcția la apăsare lungă. Înapoi anulează.</string>
    <string name="remote_buttons_learn_waiting">Se așteaptă un buton…</string>
    <string name="remote_buttons_learn_let_go">Apăsare lungă detectată. Eliberează butonul.</string>
    <string name="remote_buttons_learn_nothing">Încă n-a sosit nimic. Unele butoane, cum ar fi Home, microfonul, volumul și butoanele Netflix sau YouTube, aparțin dispozitivului și nu ajung niciodată la aplicație. Dacă folosești telecomanda televizorului, televizorul poate să nu transmită acest buton dispozitivului. Încearcă alt buton sau eliberează-l pe acela cu o aplicație de remapare a butoanelor, cum ar fi tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: nu se poate schimba. OK, Stânga, Dreapta și Înapoi își păstrează mereu funcțiile obișnuite, ca nimeni să nu rămână blocat în player. Apasă alt buton.</string>
    <string name="remote_buttons_learn_volume">Volumul rămâne controlat de dispozitiv sau de televizor. Apasă alt buton.</string>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Botões do comando</string>
    <string name="remote_buttons_section_desc">Dá uma função aos botões do comando enquanto vês.</string>
    <string name="remote_buttons_intro">Cada botão pode ter uma função de toque e uma função de manter premido. OK, Esquerda, Direita e Voltar mantêm sempre as suas funções habituais. Cima e Baixo podem ter uma função para quando os controlos do leitor estão escondidos. O volume continua a ser controlado pela box ou pela TV.</string>
    <string name="remote_buttons_setup_title">Configurar um botão</string>
    <string name="remote_buttons_setup_subtitle">Carrega nele ou mantém-no premido no comando e escolhe a sua função</string>
    <string name="remote_buttons_reset">Repor todos os botões</string>
    <string name="remote_buttons_mapper_note">Usas o tvQuickActions ou o Button Mapper? Configura lá o botão para enviar uma tecla, por exemplo Vermelho ou Info, e escolhe aqui a função dessa tecla.</string>
    <string name="remote_buttons_hold_note">Manter premido funciona quando a box passa o botão mantido premido à app. Se, em Configurar um botão, nunca é detetado um toque longo, nesta box esse botão só tem função de toque.</string>
    <string name="remote_buttons_number_keys">Teclas numéricas</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = a meio, 0 = início</string>
    <string name="remote_buttons_added">Configurado nesta box</string>
    <string name="remote_buttons_up_down_row">Com os controlos escondidos</string>
    <string name="remote_buttons_up_down_desc">Só enquanto os controlos do leitor estão escondidos. Com os controlos visíveis, Cima e Baixo movem-se por eles como habitualmente.</string>
    <string name="remote_buttons_learn_title">Configurar um botão</string>
    <string name="remote_buttons_learn_subtitle">Carrega no botão do comando a que queres dar uma função. Mantém-no premido para definir a função de manter premido. Voltar cancela.</string>
    <string name="remote_buttons_learn_waiting">À espera de um botão…</string>
    <string name="remote_buttons_learn_let_go">Toque longo detetado. Solta o botão.</string>
    <string name="remote_buttons_learn_nothing">Ainda não chegou nada. Alguns botões, como Home, o microfone, o volume e os botões Netflix ou YouTube, pertencem à box e nunca chegam à app. Se usas o comando da TV, a TV pode não passar este botão à box. Experimenta outro botão ou liberta esse com uma app de mapeamento de botões, como o tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: não é possível alterar. OK, Esquerda, Direita e Voltar mantêm sempre as suas funções habituais, para ninguém ficar preso no leitor. Carrega noutro botão.</string>
    <string name="remote_buttons_learn_volume">O volume continua a ser controlado pela box ou pela TV. Carrega noutro botão.</string>

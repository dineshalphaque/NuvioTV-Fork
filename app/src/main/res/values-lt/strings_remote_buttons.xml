<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Pultelio mygtukai</string>
    <string name="remote_buttons_section_desc">Priskirkite pultelio mygtukams veiksmus žiūrėjimo metu.</string>
    <string name="remote_buttons_intro">Kiekvienas mygtukas gali turėti paspaudimo veiksmą ir laikymo veiksmą. OK, „Kairėn“, „Dešinėn“ ir „Atgal“ visada atlieka įprastus veiksmus. „Aukštyn“ ir „Žemyn“ gali gauti veiksmą tam laikui, kol grotuvo valdikliai paslėpti. Garsumą valdo įrenginys arba televizorius.</string>
    <string name="remote_buttons_setup_title">Nustatyti mygtuką</string>
    <string name="remote_buttons_setup_subtitle">Paspauskite arba palaikykite jį pultelyje, tada pasirinkite veiksmą</string>
    <string name="remote_buttons_reset">Atkurti visus mygtukus</string>
    <string name="remote_buttons_mapper_note">Naudojate tvQuickActions arba Button Mapper? Ten nustatykite, kad mygtukas siųstų klavišą, pvz., „Raudonas“ arba „Info“, tada čia pasirinkite to klavišo veiksmą.</string>
    <string name="remote_buttons_hold_note">Laikymas veikia, kai įrenginys perduoda laikomą mygtuką programai. Jei laikymas niekada nepasirodo lange „Nustatyti mygtuką“, tas mygtukas šiame įrenginyje turi tik paspaudimo veiksmą.</string>
    <string name="remote_buttons_number_keys">Skaičių mygtukai</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = vidurys, 0 = pradžia</string>
    <string name="remote_buttons_added">Nustatytas šiame įrenginyje</string>
    <string name="remote_buttons_up_down_row">Kol valdikliai paslėpti</string>
    <string name="remote_buttons_up_down_desc">Tik kol grotuvo valdikliai paslėpti. Kai valdikliai rodomi, „Aukštyn“ ir „Žemyn“ juda po juos kaip įprasta.</string>
    <string name="remote_buttons_learn_title">Nustatyti mygtuką</string>
    <string name="remote_buttons_learn_subtitle">Paspauskite pultelio mygtuką, kuriam norite priskirti veiksmą. Palaikykite jį, kad vietoj to nustatytumėte jo laikymo veiksmą. „Atgal“ atšaukia.</string>
    <string name="remote_buttons_learn_waiting">Laukiama mygtuko…</string>
    <string name="remote_buttons_learn_let_go">Aptiktas laikymas. Atleiskite mygtuką.</string>
    <string name="remote_buttons_learn_nothing">Kol kas nieko negauta. Kai kurie mygtukai, pvz., „Pagrindinis“, mikrofonas, garsumas ir Netflix ar YouTube mygtukai, priklauso įrenginiui ir niekada nepasiekia programos. Jei naudojate televizoriaus pultelį, televizorius gali neperduoti šio mygtuko įrenginiui. Išbandykite kitą mygtuką arba atlaisvinkite šį mygtukų perskirstymo programa, pvz., tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: negalima pakeisti. OK, „Kairėn“, „Dešinėn“ ir „Atgal“ visada atlieka įprastus veiksmus, kad niekas neužstrigtų grotuve. Paspauskite kitą mygtuką.</string>
    <string name="remote_buttons_learn_volume">Garsumą valdo įrenginys arba televizorius. Paspauskite kitą mygtuką.</string>

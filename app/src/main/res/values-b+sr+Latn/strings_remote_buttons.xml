<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Dugmad daljinskog</string>
    <string name="remote_buttons_section_desc">Dodelite funkcije dugmadi daljinskog tokom gledanja.</string>
    <string name="remote_buttons_intro">Svako dugme može da ima funkciju na pritisak i funkciju na držanje. OK, „Levo“, „Desno“ i „Nazad“ uvek zadržavaju svoje uobičajene funkcije. „Gore“ i „Dole“ mogu da dobiju funkciju za vreme dok su kontrole plejera sakrivene. Jačinom zvuka upravlja uređaj ili televizor.</string>
    <string name="remote_buttons_setup_title">Podesi dugme</string>
    <string name="remote_buttons_setup_subtitle">Pritisnite ga ili ga držite na daljinskom, pa izaberite funkciju</string>
    <string name="remote_buttons_reset">Resetuj svu dugmad</string>
    <string name="remote_buttons_mapper_note">Koristite tvQuickActions ili Button Mapper? Tamo podesite dugme da šalje taster, na primer „Crveno“ ili „Info“, pa ovde izaberite funkciju tog tastera.</string>
    <string name="remote_buttons_hold_note">Držanje radi kada uređaj prosleđuje držano dugme aplikaciji. Ako se držanje nikad ne pojavi u „Podesi dugme“, to dugme na ovom uređaju ima samo funkciju na pritisak.</string>
    <string name="remote_buttons_number_keys">Dugmad sa brojevima</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = polovina, 0 = početak</string>
    <string name="remote_buttons_added">Podešeno na ovom uređaju</string>
    <string name="remote_buttons_up_down_row">Dok su kontrole sakrivene</string>
    <string name="remote_buttons_up_down_desc">Samo dok su kontrole plejera sakrivene. Kada su kontrole prikazane, „Gore“ i „Dole“ se kreću po njima kao i obično.</string>
    <string name="remote_buttons_learn_title">Podesi dugme</string>
    <string name="remote_buttons_learn_subtitle">Pritisnite dugme na daljinskom kojem želite da dodelite funkciju. Držite ga da biste umesto toga podesili funkciju na držanje. „Nazad“ otkazuje.</string>
    <string name="remote_buttons_learn_waiting">Čeka se dugme…</string>
    <string name="remote_buttons_learn_let_go">Držanje prepoznato. Pustite dugme.</string>
    <string name="remote_buttons_learn_nothing">Još ništa nije stiglo. Neka dugmad, kao što su „Početna“, mikrofon, jačina zvuka i dugmad Netflix ili YouTube, pripadaju uređaju i nikad ne stižu do aplikacije. Ako koristite daljinski od televizora, televizor možda ne prosleđuje ovo dugme uređaju. Probajte drugo dugme ili oslobodite ovo pomoću aplikacije za mapiranje dugmadi, kao što je tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: ne može da se promeni. OK, „Levo“, „Desno“ i „Nazad“ uvek zadržavaju svoje uobičajene funkcije, da se niko ne bi zaglavio u plejeru. Pritisnite drugo dugme.</string>
    <string name="remote_buttons_learn_volume">Jačinom zvuka upravlja uređaj ili televizor. Pritisnite drugo dugme.</string>

<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Kumanda tuşları</string>
    <string name="remote_buttons_section_desc">İzlerken kumanda tuşlarına bir işlev verin.</string>
    <string name="remote_buttons_intro">Her tuşun bir basma işlevi ve bir basılı tutma işlevi olabilir. OK, Sol, Sağ ve Geri her zaman olağan işlevlerini korur. Yukarı ve Aşağı, oynatıcı kontrolleri gizliyken geçerli bir işlev alabilir. Ses düzeyi cihazınız veya televizyonunuz tarafından yönetilir.</string>
    <string name="remote_buttons_setup_title">Tuş ayarla</string>
    <string name="remote_buttons_setup_subtitle">Kumandada tuşa basın veya basılı tutun, ardından işlevini seçin</string>
    <string name="remote_buttons_reset">Tüm tuşları sıfırla</string>
    <string name="remote_buttons_mapper_note">tvQuickActions veya Button Mapper mı kullanıyorsunuz? Tuşunuzu orada Kırmızı veya Bilgi gibi bir tuş gönderecek şekilde ayarlayın, ardından o tuşun işlevini burada seçin.</string>
    <string name="remote_buttons_hold_note">Basılı tutma, cihazınız basılı tutulan tuşu uygulamaya ilettiğinde çalışır. Tuş ayarla sırasında basılı tutma hiç görünmüyorsa o tuşun bu cihazda yalnızca basma işlevi vardır.</string>
    <string name="remote_buttons_number_keys">Rakam tuşları</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = %10, 5 = yarısı, 0 = başlangıç</string>
    <string name="remote_buttons_added">Bu cihazda ayarlı</string>
    <string name="remote_buttons_up_down_row">Kontroller gizliyken</string>
    <string name="remote_buttons_up_down_desc">Yalnızca oynatıcı kontrolleri gizliyken. Kontroller görünürken Yukarı ve Aşağı her zamanki gibi kontroller arasında gezinir.</string>
    <string name="remote_buttons_learn_title">Tuş ayarla</string>
    <string name="remote_buttons_learn_subtitle">Kumandada işlev vermek istediğiniz tuşa basın. Bunun yerine basılı tutma işlevini ayarlamak için tuşu basılı tutun. Geri iptal eder.</string>
    <string name="remote_buttons_learn_waiting">Tuş bekleniyor…</string>
    <string name="remote_buttons_learn_let_go">Basılı tutma algılandı. Tuşu bırakın.</string>
    <string name="remote_buttons_learn_nothing">Henüz bir şey gelmedi. Ana Menü, mikrofon, ses düzeyi ve Netflix ya da YouTube tuşları gibi bazı tuşlar cihazınıza aittir ve uygulamaya hiç ulaşmaz. TV kumandasını kullanıyorsanız televizyonunuz bu tuşu cihaza iletmeyebilir. Başka bir tuş deneyin veya o tuşu tvQuickActions gibi bir tuş eşleme uygulamasıyla serbest bırakın.</string>
    <string name="remote_buttons_learn_locked">%1$s değiştirilemez. OK, Sol, Sağ ve Geri, kimse oynatıcıda takılı kalmasın diye her zaman olağan işlevlerini korur. Başka bir tuşa basın.</string>
    <string name="remote_buttons_learn_volume">Ses düzeyi cihazınız veya televizyonunuz tarafından yönetilir. Başka bir tuşa basın.</string>

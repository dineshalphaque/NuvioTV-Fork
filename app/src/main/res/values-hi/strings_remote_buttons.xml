<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">रिमोट बटन</string>
    <string name="remote_buttons_section_desc">देखते समय रिमोट बटनों को कोई काम दें।</string>
    <string name="remote_buttons_intro">हर बटन को दबाने का काम और दबाए रखने का काम दिया जा सकता है। OK, बाएँ, दाएँ और बैक हमेशा अपना सामान्य काम करते हैं। ऊपर और नीचे को ऐसा काम दिया जा सकता है जो प्लेयर के कंट्रोल छिपे होने पर चले। वॉल्यूम आपका डिवाइस या TV ही संभालता है।</string>
    <string name="remote_buttons_setup_title">बटन सेट करें</string>
    <string name="remote_buttons_setup_subtitle">इसे अपने रिमोट पर दबाएँ या दबाए रखें, फिर इसका काम चुनें</string>
    <string name="remote_buttons_reset">सभी बटन रीसेट करें</string>
    <string name="remote_buttons_mapper_note">tvQuickActions या Button Mapper इस्तेमाल करते हैं? वहाँ अपने बटन को कोई दूसरा बटन भेजने के लिए सेट करें, जैसे लाल या इन्फो, फिर यहाँ उस बटन का काम चुनें।</string>
    <string name="remote_buttons_hold_note">दबाए रखना तभी काम करता है जब आपका डिवाइस दबाए रखे बटन को ऐप तक भेजे। अगर “बटन सेट करें” में दबाए रखना कभी नहीं दिखता, तो इस डिवाइस पर उस बटन का सिर्फ़ दबाने का काम है।</string>
    <string name="remote_buttons_number_keys">नंबर बटन</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = आधा, 0 = शुरुआत</string>
    <string name="remote_buttons_added">इस डिवाइस पर सेट</string>
    <string name="remote_buttons_up_down_row">जब कंट्रोल छिपे हों</string>
    <string name="remote_buttons_up_down_desc">सिर्फ़ तब जब प्लेयर के कंट्रोल छिपे हों। कंट्रोल दिखने पर ऊपर और नीचे हमेशा की तरह उनमें घूमते हैं।</string>
    <string name="remote_buttons_learn_title">बटन सेट करें</string>
    <string name="remote_buttons_learn_subtitle">रिमोट पर वह बटन दबाएँ जिसे आप कोई काम देना चाहते हैं। इसके बजाय दबाए रखने का काम सेट करने के लिए उसे दबाए रखें। बैक दबाने पर रद्द।</string>
    <string name="remote_buttons_learn_waiting">बटन का इंतज़ार…</string>
    <string name="remote_buttons_learn_let_go">दबाए रखना पहचाना गया। बटन छोड़ दें।</string>
    <string name="remote_buttons_learn_nothing">अभी तक कुछ नहीं आया। कुछ बटन, जैसे होम, माइक्रोफ़ोन, वॉल्यूम और Netflix या YouTube बटन, आपके डिवाइस के होते हैं और ऐप तक कभी नहीं पहुँचते। अगर आप TV का रिमोट इस्तेमाल करते हैं, तो हो सकता है आपका TV यह बटन डिवाइस तक न भेजे। कोई दूसरा बटन आज़माएँ, या tvQuickActions जैसे बटन-मैपर ऐप से उस बटन को खाली करें।</string>
    <string name="remote_buttons_learn_locked">%1$s को बदला नहीं जा सकता। OK, बाएँ, दाएँ और बैक हमेशा अपना सामान्य काम करते हैं, ताकि कोई भी प्लेयर में फँस न जाए। कोई दूसरा बटन दबाएँ।</string>
    <string name="remote_buttons_learn_volume">वॉल्यूम आपका डिवाइस या TV ही संभालता है। कोई दूसरा बटन दबाएँ।</string>

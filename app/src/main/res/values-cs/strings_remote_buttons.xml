<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Tlačítka ovladače</string>
    <string name="remote_buttons_section_desc">Přiřaďte tlačítkům ovladače funkce při sledování.</string>
    <string name="remote_buttons_intro">Každé tlačítko může mít funkci pro stisknutí a funkci pro podržení. OK, Vlevo, Vpravo a Zpět si vždy ponechávají své obvyklé funkce. Nahoru a Dolů mohou dostat funkci pro dobu, kdy jsou ovládací prvky přehrávače skryté. Hlasitost dál ovládá zařízení nebo televizor.</string>
    <string name="remote_buttons_setup_title">Nastavit tlačítko</string>
    <string name="remote_buttons_setup_subtitle">Stiskněte ho nebo podržte na ovladači a pak vyberte jeho funkci</string>
    <string name="remote_buttons_reset">Obnovit všechna tlačítka</string>
    <string name="remote_buttons_mapper_note">Používáte tvQuickActions nebo Button Mapper? Nastavte tam tlačítko tak, aby posílalo klávesu, například Červené nebo Info, a pak zde vyberte funkci této klávesy.</string>
    <string name="remote_buttons_hold_note">Podržení funguje, když zařízení předá podržené tlačítko aplikaci. Pokud se v Nastavit tlačítko podržení nikdy neobjeví, má toto tlačítko na tomto zařízení jen funkci pro stisknutí.</string>
    <string name="remote_buttons_number_keys">Číselná tlačítka</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = polovina, 0 = začátek</string>
    <string name="remote_buttons_added">Nastaveno na tomto zařízení</string>
    <string name="remote_buttons_up_down_row">Když jsou ovládací prvky skryté</string>
    <string name="remote_buttons_up_down_desc">Jen když jsou ovládací prvky přehrávače skryté. Když jsou zobrazené, Nahoru a Dolů se po nich pohybují jako obvykle.</string>
    <string name="remote_buttons_learn_title">Nastavit tlačítko</string>
    <string name="remote_buttons_learn_subtitle">Stiskněte na ovladači tlačítko, kterému chcete přiřadit funkci. Podržte ho, chcete-li nastavit funkci pro podržení. Zpět zruší.</string>
    <string name="remote_buttons_learn_waiting">Čekání na tlačítko…</string>
    <string name="remote_buttons_learn_let_go">Zjištěno podržení. Pusťte tlačítko.</string>
    <string name="remote_buttons_learn_nothing">Zatím nic nepřišlo. Některá tlačítka, například Home, mikrofon, hlasitost a tlačítka Netflix nebo YouTube, patří zařízení a do aplikace se nikdy nedostanou. Pokud používáte ovladač od televizoru, televizor nemusí toto tlačítko zařízení předávat. Zkuste jiné tlačítko, nebo ho uvolněte aplikací pro přemapování tlačítek, například tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: nelze změnit. OK, Vlevo, Vpravo a Zpět si vždy ponechávají své obvyklé funkce, aby nikdo neuvízl v přehrávači. Stiskněte jiné tlačítko.</string>
    <string name="remote_buttons_learn_volume">Hlasitost dál ovládá zařízení nebo televizor. Stiskněte jiné tlačítko.</string>

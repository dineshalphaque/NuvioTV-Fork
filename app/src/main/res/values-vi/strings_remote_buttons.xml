<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Nút điều khiển từ xa</string>
    <string name="remote_buttons_section_desc">Gán chức năng cho các nút trên điều khiển khi xem.</string>
    <string name="remote_buttons_intro">Mỗi nút có thể có một chức năng khi nhấn và một chức năng khi giữ. OK, Trái, Phải và Quay lại luôn giữ chức năng thông thường. Lên và Xuống có thể nhận chức năng dùng khi thanh điều khiển của trình phát đang ẩn. Âm lượng vẫn do thiết bị hoặc TV của bạn điều khiển.</string>
    <string name="remote_buttons_setup_title">Thiết lập nút</string>
    <string name="remote_buttons_setup_subtitle">Nhấn hoặc giữ nút đó trên điều khiển, rồi chọn chức năng</string>
    <string name="remote_buttons_reset">Đặt lại tất cả nút</string>
    <string name="remote_buttons_mapper_note">Đang dùng tvQuickActions hoặc Button Mapper? Hãy đặt nút ở đó để gửi một phím, ví dụ Đỏ hoặc Thông tin, rồi chọn chức năng của phím đó tại đây.</string>
    <string name="remote_buttons_hold_note">Giữ nút chỉ hoạt động khi thiết bị chuyển nút đang giữ sang ứng dụng. Nếu thao tác giữ không bao giờ hiện trong Thiết lập nút, nút đó chỉ có chức năng khi nhấn trên thiết bị này.</string>
    <string name="remote_buttons_number_keys">Phím số</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = giữa, 0 = đầu</string>
    <string name="remote_buttons_added">Đã thiết lập trên thiết bị này</string>
    <string name="remote_buttons_up_down_row">Khi thanh điều khiển đang ẩn</string>
    <string name="remote_buttons_up_down_desc">Chỉ khi thanh điều khiển của trình phát đang ẩn. Khi thanh điều khiển đang hiện, Lên và Xuống di chuyển trong đó như bình thường.</string>
    <string name="remote_buttons_learn_title">Thiết lập nút</string>
    <string name="remote_buttons_learn_subtitle">Nhấn nút trên điều khiển mà bạn muốn gán chức năng. Giữ nút để đặt chức năng khi giữ thay vì khi nhấn. Nhấn Quay lại để hủy.</string>
    <string name="remote_buttons_learn_waiting">Đang chờ nút…</string>
    <string name="remote_buttons_learn_let_go">Đã nhận thao tác giữ. Hãy thả nút ra.</string>
    <string name="remote_buttons_learn_nothing">Chưa nhận được gì. Một số nút, như Trang chủ, micrô, âm lượng và nút Netflix hoặc YouTube, thuộc về thiết bị và không bao giờ đến được ứng dụng. Nếu bạn dùng điều khiển của TV, TV có thể không chuyển nút này sang thiết bị. Hãy thử nút khác, hoặc giải phóng nút đó bằng ứng dụng gán nút như tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s không thể thay đổi. OK, Trái, Phải và Quay lại luôn giữ chức năng thông thường để không ai bị kẹt trong trình phát. Hãy nhấn nút khác.</string>
    <string name="remote_buttons_learn_volume">Âm lượng vẫn do thiết bị hoặc TV của bạn điều khiển. Hãy nhấn nút khác.</string>

<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">遥控器按键</string>
    <string name="remote_buttons_section_desc">观看时为遥控器按键指定功能。</string>
    <string name="remote_buttons_intro">每个按键都可以有短按功能和长按功能。OK、左、右和返回键始终保持原有功能。上和下可以指定在播放器控件隐藏时使用的功能。音量仍由设备或电视控制。</string>
    <string name="remote_buttons_setup_title">设置按键</string>
    <string name="remote_buttons_setup_subtitle">在遥控器上按下或长按该键，然后选择它的功能</string>
    <string name="remote_buttons_reset">重置所有按键</string>
    <string name="remote_buttons_mapper_note">正在使用 tvQuickActions 或 Button Mapper？请在那里将按键设为发送某个键，例如红色键或信息键，然后在这里选择该键的功能。</string>
    <string name="remote_buttons_hold_note">只有当设备把长按的按键传给应用时，长按才有效。如果在“设置按键”中始终检测不到长按，说明该键在此设备上只有短按功能。</string>
    <string name="remote_buttons_number_keys">数字键</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %，5 = 一半，0 = 开头</string>
    <string name="remote_buttons_added">已在此设备上设置</string>
    <string name="remote_buttons_up_down_row">控件隐藏时</string>
    <string name="remote_buttons_up_down_desc">仅在播放器控件隐藏时有效。控件显示时，上和下照常在控件中移动。</string>
    <string name="remote_buttons_learn_title">设置按键</string>
    <string name="remote_buttons_learn_subtitle">按下遥控器上要指定功能的按键。长按则改为设置它的长按功能。按返回键取消。</string>
    <string name="remote_buttons_learn_waiting">正在等待按键…</string>
    <string name="remote_buttons_learn_let_go">已检测到长按。请松开按键。</string>
    <string name="remote_buttons_learn_nothing">尚未收到任何按键。主页键、麦克风、音量以及 Netflix 或 YouTube 等按键属于设备本身，永远不会传到应用。如果您使用电视遥控器，电视可能不会把这个键传给设备。请换一个按键，或用 tvQuickActions 等按键映射应用释放该键。</string>
    <string name="remote_buttons_learn_locked">“%1$s”无法更改。OK、左、右和返回键始终保持原有功能，以免有人被困在播放器中。请按其他按键。</string>
    <string name="remote_buttons_learn_volume">音量仍由设备或电视控制。请按其他按键。</string>

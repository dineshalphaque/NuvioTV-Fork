<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Gumbi daljinskog</string>
    <string name="remote_buttons_section_desc">Dodijeli gumbima daljinskog funkcije tijekom gledanja.</string>
    <string name="remote_buttons_intro">Svaki gumb može imati funkciju na pritisak i funkciju na držanje. OK, „Lijevo“, „Desno“ i „Natrag“ uvijek zadržavaju svoje uobičajene funkcije. „Gore“ i „Dolje“ mogu dobiti funkciju za vrijeme dok su kontrole playera skrivene. Glasnoćom upravlja uređaj ili televizor.</string>
    <string name="remote_buttons_setup_title">Postavi gumb</string>
    <string name="remote_buttons_setup_subtitle">Pritisni ga ili ga drži na daljinskom, zatim odaberi njegovu funkciju</string>
    <string name="remote_buttons_reset">Poništi sve gumbe</string>
    <string name="remote_buttons_mapper_note">Koristiš tvQuickActions ili Button Mapper? Ondje postavi da gumb šalje tipku, na primjer „Crveni“ ili „Info“, zatim ovdje odaberi funkciju te tipke.</string>
    <string name="remote_buttons_hold_note">Držanje radi kad uređaj prosljeđuje držani gumb aplikaciji. Ako se držanje nikad ne pojavi u „Postavi gumb“, taj gumb na ovom uređaju ima samo funkciju na pritisak.</string>
    <string name="remote_buttons_number_keys">Brojčani gumbi</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = polovica, 0 = početak</string>
    <string name="remote_buttons_added">Postavljen na ovom uređaju</string>
    <string name="remote_buttons_up_down_row">Dok su kontrole skrivene</string>
    <string name="remote_buttons_up_down_desc">Samo dok su kontrole playera skrivene. Kad su kontrole prikazane, „Gore“ i „Dolje“ kreću se po njima kao i obično.</string>
    <string name="remote_buttons_learn_title">Postavi gumb</string>
    <string name="remote_buttons_learn_subtitle">Pritisni gumb na daljinskom kojem želiš dodijeliti funkciju. Drži ga da umjesto toga postaviš njegovu funkciju na držanje. „Natrag“ odustaje.</string>
    <string name="remote_buttons_learn_waiting">Čekam gumb…</string>
    <string name="remote_buttons_learn_let_go">Držanje prepoznato. Pusti gumb.</string>
    <string name="remote_buttons_learn_nothing">Još ništa nije stiglo. Neki gumbi, poput gumba „Početna“, mikrofona, glasnoće te gumba Netflix ili YouTube, pripadaju uređaju i nikad ne stignu do aplikacije. Ako koristiš daljinski od televizora, televizor možda ne prosljeđuje taj gumb uređaju. Pokušaj s drugim gumbom ili oslobodi taj pomoću aplikacije za mapiranje gumba, kao što je tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: ne može se promijeniti. OK, „Lijevo“, „Desno“ i „Natrag“ uvijek zadržavaju svoje uobičajene funkcije, da nitko ne zapne u playeru. Pritisni drugi gumb.</string>
    <string name="remote_buttons_learn_volume">Glasnoćom upravlja uređaj ili televizor. Pritisni drugi gumb.</string>

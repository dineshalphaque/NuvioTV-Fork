<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">遙控器按鍵</string>
    <string name="remote_buttons_section_desc">觀看時為遙控器按鍵指定功能。</string>
    <string name="remote_buttons_intro">每個按鍵都可以有短按功能和長按功能。OK、左、右和返回鍵一律保留原本的功能。上和下可以指定在播放器控制項隱藏時使用的功能。音量仍由裝置或電視控制。</string>
    <string name="remote_buttons_setup_title">設定按鍵</string>
    <string name="remote_buttons_setup_subtitle">在遙控器上按下或長按該鍵，然後選擇它的功能</string>
    <string name="remote_buttons_reset">重設所有按鍵</string>
    <string name="remote_buttons_mapper_note">正在使用 tvQuickActions 或 Button Mapper？請在那裡將按鍵設為送出某個鍵，例如紅色鍵或資訊鍵，然後在這裡選擇該鍵的功能。</string>
    <string name="remote_buttons_hold_note">只有當裝置把長按的按鍵傳給應用程式時，長按才有效。如果在「設定按鍵」中始終偵測不到長按，表示該鍵在此裝置上只有短按功能。</string>
    <string name="remote_buttons_number_keys">數字鍵</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %，5 = 一半，0 = 開頭</string>
    <string name="remote_buttons_added">已在此裝置上設定</string>
    <string name="remote_buttons_up_down_row">控制項隱藏時</string>
    <string name="remote_buttons_up_down_desc">僅在播放器控制項隱藏時有效。控制項顯示時，上和下照常在控制項中移動。</string>
    <string name="remote_buttons_learn_title">設定按鍵</string>
    <string name="remote_buttons_learn_subtitle">按下遙控器上要指定功能的按鍵。長按則改為設定它的長按功能。按返回鍵取消。</string>
    <string name="remote_buttons_learn_waiting">正在等待按鍵…</string>
    <string name="remote_buttons_learn_let_go">已偵測到長按。請放開按鍵。</string>
    <string name="remote_buttons_learn_nothing">尚未收到任何按鍵。主畫面鍵、麥克風、音量以及 Netflix 或 YouTube 等按鍵屬於裝置本身，永遠不會傳到應用程式。如果您使用電視遙控器，電視可能不會把這個鍵傳給裝置。請換一個按鍵，或用 tvQuickActions 等按鍵對應應用程式釋放該鍵。</string>
    <string name="remote_buttons_learn_locked">「%1$s」無法變更。OK、左、右和返回鍵一律保留原本的功能，以免有人被困在播放器中。請按其他按鍵。</string>
    <string name="remote_buttons_learn_volume">音量仍由裝置或電視控制。請按其他按鍵。</string>

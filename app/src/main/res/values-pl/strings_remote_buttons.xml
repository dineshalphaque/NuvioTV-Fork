<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Przyciski pilota</string>
    <string name="remote_buttons_section_desc">Przypisz przyciskom pilota funkcje na czas oglądania.</string>
    <string name="remote_buttons_intro">Każdy przycisk może mieć funkcję na naciśnięcie i funkcję na przytrzymanie. OK, Lewo, Prawo i Wstecz zawsze zachowują swoje zwykłe funkcje. Góra i Dół mogą dostać funkcję na czas, gdy kontrolki odtwarzacza są ukryte. Głośnością nadal steruje urządzenie lub telewizor.</string>
    <string name="remote_buttons_setup_title">Ustaw przycisk</string>
    <string name="remote_buttons_setup_subtitle">Naciśnij go lub przytrzymaj na pilocie, a potem wybierz jego funkcję</string>
    <string name="remote_buttons_reset">Resetuj wszystkie przyciski</string>
    <string name="remote_buttons_mapper_note">Używasz tvQuickActions lub Button Mapper? Ustaw tam przycisk tak, by wysyłał klawisz, na przykład Czerwony lub Info, a potem wybierz tutaj funkcję tego klawisza.</string>
    <string name="remote_buttons_hold_note">Przytrzymanie działa, gdy urządzenie przekazuje przytrzymany przycisk do aplikacji. Jeśli w Ustaw przycisk przytrzymanie nigdy się nie pojawia, ten przycisk ma na tym urządzeniu tylko funkcję na naciśnięcie.</string>
    <string name="remote_buttons_number_keys">Przyciski numeryczne</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = połowa, 0 = początek</string>
    <string name="remote_buttons_added">Ustawiony na tym urządzeniu</string>
    <string name="remote_buttons_up_down_row">Gdy kontrolki są ukryte</string>
    <string name="remote_buttons_up_down_desc">Tylko gdy kontrolki odtwarzacza są ukryte. Gdy kontrolki są widoczne, Góra i Dół poruszają się po nich jak zwykle.</string>
    <string name="remote_buttons_learn_title">Ustaw przycisk</string>
    <string name="remote_buttons_learn_subtitle">Naciśnij na pilocie przycisk, któremu chcesz przypisać funkcję. Przytrzymaj go, aby ustawić funkcję na przytrzymanie. Wstecz anuluje.</string>
    <string name="remote_buttons_learn_waiting">Czekam na przycisk…</string>
    <string name="remote_buttons_learn_let_go">Wykryto przytrzymanie. Puść przycisk.</string>
    <string name="remote_buttons_learn_nothing">Nic jeszcze nie dotarło. Niektóre przyciski, jak Home, mikrofon, głośność oraz przyciski Netflix i YouTube, należą do urządzenia i nigdy nie trafiają do aplikacji. Jeśli używasz pilota od telewizora, telewizor może nie przekazywać tego przycisku do urządzenia. Spróbuj innego przycisku albo zwolnij ten za pomocą aplikacji do mapowania przycisków, np. tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: nie można zmienić. OK, Lewo, Prawo i Wstecz zawsze zachowują swoje zwykłe funkcje, żeby nikt nie utknął w odtwarzaczu. Naciśnij inny przycisk.</string>
    <string name="remote_buttons_learn_volume">Głośnością nadal steruje urządzenie lub telewizor. Naciśnij inny przycisk.</string>

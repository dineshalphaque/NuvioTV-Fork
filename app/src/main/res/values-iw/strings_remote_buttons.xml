<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">כפתורי השלט</string>
    <string name="remote_buttons_section_desc">הקצאת פעולה לכפתורי השלט בזמן הצפייה.</string>
    <string name="remote_buttons_intro">לכל כפתור יכולות להיות פעולת לחיצה ופעולת לחיצה ארוכה. OK, שמאלה, ימינה וכפתור החזרה תמיד שומרים על הפעולות הרגילות שלהם. למעלה ולמטה יכולים לקבל פעולה לזמן שבו פקדי הנגן מוסתרים. עוצמת הקול נשארת בשליטת המכשיר או הטלוויזיה.</string>
    <string name="remote_buttons_setup_title">הגדרת כפתור</string>
    <string name="remote_buttons_setup_subtitle">יש ללחוץ עליו או ללחוץ עליו לחיצה ארוכה בשלט ואז לבחור את הפעולה שלו</string>
    <string name="remote_buttons_reset">איפוס כל הכפתורים</string>
    <string name="remote_buttons_mapper_note">משתמשים ב-tvQuickActions או ב-Button Mapper? יש להגדיר שם את הכפתור כך שישלח מקש, למשל אדום או מידע, ואז לבחור כאן את הפעולה של המקש הזה.</string>
    <string name="remote_buttons_hold_note">לחיצות ארוכות עובדות כשהמכשיר מעביר לאפליקציה את הכפתור המוחזק. אם לחיצה ארוכה אף פעם לא מופיעה בהגדרת כפתור, לכפתור הזה יש רק פעולת לחיצה במכשיר הזה.</string>
    <string name="remote_buttons_number_keys">מקשי מספרים</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = באמצע, 0 = התחלה</string>
    <string name="remote_buttons_added">מוגדר במכשיר הזה</string>
    <string name="remote_buttons_up_down_row">כשהפקדים מוסתרים</string>
    <string name="remote_buttons_up_down_desc">רק כשפקדי הנגן מוסתרים. כשהפקדים מוצגים, למעלה ולמטה מנווטים ביניהם כרגיל.</string>
    <string name="remote_buttons_learn_title">הגדרת כפתור</string>
    <string name="remote_buttons_learn_subtitle">יש ללחוץ בשלט על הכפתור שרוצים להקצות לו פעולה. לחיצה ארוכה מגדירה במקום זאת את פעולת הלחיצה הארוכה שלו. כפתור החזרה מבטל.</string>
    <string name="remote_buttons_learn_waiting">ממתין לכפתור…</string>
    <string name="remote_buttons_learn_let_go">זוהתה לחיצה ארוכה. אפשר לשחרר את הכפתור.</string>
    <string name="remote_buttons_learn_nothing">עדיין לא התקבל כלום. חלק מהכפתורים, כמו כפתור הבית, המיקרופון, עוצמת הקול וכפתורי Netflix או YouTube, שייכים למכשיר ולא מגיעים לאפליקציה. אם משתמשים בשלט של הטלוויזיה, ייתכן שהטלוויזיה לא מעבירה את הכפתור הזה למכשיר. אפשר לנסות כפתור אחר, או לשחרר את הכפתור הזה בעזרת אפליקציה למיפוי כפתורים כמו tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: לא ניתן לשנות. OK, שמאלה, ימינה וכפתור החזרה תמיד שומרים על הפעולות הרגילות שלהם, כדי שאף אחד לא ייתקע בנגן. יש ללחוץ על כפתור אחר.</string>
    <string name="remote_buttons_learn_volume">עוצמת הקול נשארת בשליטת המכשיר או הטלוויזיה. יש ללחוץ על כפתור אחר.</string>

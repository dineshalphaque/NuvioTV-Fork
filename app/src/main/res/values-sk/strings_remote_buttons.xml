<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Tlačidlá ovládača</string>
    <string name="remote_buttons_section_desc">Priraďte tlačidlám ovládača funkcie počas sledovania.</string>
    <string name="remote_buttons_intro">Každé tlačidlo môže mať funkciu pre stlačenie a funkciu pre podržanie. OK, Vľavo, Vpravo a Späť si vždy ponechávajú svoje bežné funkcie. Hore a Dole môžu dostať funkciu na čas, keď sú ovládacie prvky prehrávača skryté. Hlasitosť naďalej ovláda zariadenie alebo televízor.</string>
    <string name="remote_buttons_setup_title">Nastaviť tlačidlo</string>
    <string name="remote_buttons_setup_subtitle">Stlačte ho alebo podržte na ovládači a potom vyberte jeho funkciu</string>
    <string name="remote_buttons_reset">Obnoviť všetky tlačidlá</string>
    <string name="remote_buttons_mapper_note">Používate tvQuickActions alebo Button Mapper? Nastavte tam tlačidlo tak, aby posielalo kláves, napríklad Červené alebo Info, a potom tu vyberte funkciu tohto klávesu.</string>
    <string name="remote_buttons_hold_note">Podržanie funguje, keď zariadenie odovzdá podržané tlačidlo aplikácii. Ak sa v Nastaviť tlačidlo podržanie nikdy neobjaví, má toto tlačidlo na tomto zariadení len funkciu pre stlačenie.</string>
    <string name="remote_buttons_number_keys">Číselné tlačidlá</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = polovica, 0 = začiatok</string>
    <string name="remote_buttons_added">Nastavené na tomto zariadení</string>
    <string name="remote_buttons_up_down_row">Keď sú ovládacie prvky skryté</string>
    <string name="remote_buttons_up_down_desc">Len keď sú ovládacie prvky prehrávača skryté. Keď sú zobrazené, Hore a Dole sa po nich pohybujú ako zvyčajne.</string>
    <string name="remote_buttons_learn_title">Nastaviť tlačidlo</string>
    <string name="remote_buttons_learn_subtitle">Stlačte na ovládači tlačidlo, ktorému chcete priradiť funkciu. Podržte ho, ak chcete nastaviť funkciu pre podržanie. Späť zruší.</string>
    <string name="remote_buttons_learn_waiting">Čaká sa na tlačidlo…</string>
    <string name="remote_buttons_learn_let_go">Zistené podržanie. Pustite tlačidlo.</string>
    <string name="remote_buttons_learn_nothing">Zatiaľ nič neprišlo. Niektoré tlačidlá, napríklad Home, mikrofón, hlasitosť a tlačidlá Netflix alebo YouTube, patria zariadeniu a do aplikácie sa nikdy nedostanú. Ak používate ovládač od televízora, televízor nemusí toto tlačidlo zariadeniu odovzdať. Skúste iné tlačidlo alebo ho uvoľnite aplikáciou na premapovanie tlačidiel, napríklad tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: nedá sa zmeniť. OK, Vľavo, Vpravo a Späť si vždy ponechávajú svoje bežné funkcie, aby nikto neuviazol v prehrávači. Stlačte iné tlačidlo.</string>
    <string name="remote_buttons_learn_volume">Hlasitosť naďalej ovláda zariadenie alebo televízor. Stlačte iné tlačidlo.</string>

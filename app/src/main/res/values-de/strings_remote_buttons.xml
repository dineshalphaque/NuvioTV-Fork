<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Fernbedienungstasten</string>
    <string name="remote_buttons_section_desc">Gib Tasten der Fernbedienung beim Schauen eine Funktion.</string>
    <string name="remote_buttons_intro">Jede Taste kann eine Funktion beim Drücken und eine beim Halten haben. OK, Links, Rechts und Zurück behalten immer ihre übliche Funktion. Hoch und Runter können eine Funktion bekommen, solange die Bedienelemente des Players ausgeblendet sind. Die Lautstärke regelt weiter deine Box oder dein Fernseher.</string>
    <string name="remote_buttons_setup_title">Taste einrichten</string>
    <string name="remote_buttons_setup_subtitle">Drücke oder halte sie auf der Fernbedienung und wähle dann ihre Funktion</string>
    <string name="remote_buttons_reset">Alle Tasten zurücksetzen</string>
    <string name="remote_buttons_mapper_note">Du nutzt tvQuickActions oder Button Mapper? Lass deine Taste dort eine Taste senden, zum Beispiel Rot oder Info, und wähle dann hier die Funktion dieser Taste.</string>
    <string name="remote_buttons_hold_note">Halten funktioniert, wenn deine Box die gehaltene Taste an die App weitergibt. Wird unter Taste einrichten nie ein Halten erkannt, hat diese Taste auf dieser Box nur eine Funktion beim Drücken.</string>
    <string name="remote_buttons_number_keys">Zifferntasten</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = Hälfte, 0 = Anfang</string>
    <string name="remote_buttons_added">Auf dieser Box eingerichtet</string>
    <string name="remote_buttons_up_down_row">Solange die Bedienelemente ausgeblendet sind</string>
    <string name="remote_buttons_up_down_desc">Nur solange die Bedienelemente des Players ausgeblendet sind. Sind sie zu sehen, bewegen Hoch und Runter wie gewohnt die Auswahl.</string>
    <string name="remote_buttons_learn_title">Taste einrichten</string>
    <string name="remote_buttons_learn_subtitle">Drücke die Taste auf der Fernbedienung, die eine Funktion bekommen soll. Halte sie, um stattdessen ihre Funktion beim Halten festzulegen. Zurück bricht ab.</string>
    <string name="remote_buttons_learn_waiting">Warte auf eine Taste…</string>
    <string name="remote_buttons_learn_let_go">Halten erkannt. Lass die Taste los.</string>
    <string name="remote_buttons_learn_nothing">Noch nichts angekommen. Manche Tasten wie Home, das Mikrofon, die Lautstärke und die Netflix- oder YouTube-Taste gehören zu deiner Box und erreichen die App nie. Nutzt du die Fernbedienung deines Fernsehers, gibt er diese Taste eventuell nicht an die Box weiter. Probiere eine andere Taste oder gib diese mit einer Button-Mapper-App wie tvQuickActions frei.</string>
    <string name="remote_buttons_learn_locked">%1$s: nicht änderbar. OK, Links, Rechts und Zurück behalten immer ihre übliche Funktion, damit niemand im Player hängen bleibt. Drücke eine andere Taste.</string>
    <string name="remote_buttons_learn_volume">Die Lautstärke regelt weiter deine Box oder dein Fernseher. Drücke eine andere Taste.</string>

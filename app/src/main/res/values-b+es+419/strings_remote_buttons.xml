<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">Botones del control</string>
    <string name="remote_buttons_section_desc">Asigna una función a los botones del control remoto mientras miras.</string>
    <string name="remote_buttons_intro">Cada botón puede tener una función al presionar y otra al mantener presionado. OK, Izquierda, Derecha y Atrás siempre mantienen su función habitual. Arriba y Abajo pueden tener una función para cuando los controles del reproductor están ocultos. El volumen sigue a cargo de tu dispositivo o TV.</string>
    <string name="remote_buttons_setup_title">Configurar un botón</string>
    <string name="remote_buttons_setup_subtitle">Presiónalo o mantenlo presionado en el control y elige su función</string>
    <string name="remote_buttons_reset">Restablecer todos los botones</string>
    <string name="remote_buttons_mapper_note">¿Usas tvQuickActions o Button Mapper? Configura ahí tu botón para que envíe una tecla, por ejemplo Rojo o Info, y elige aquí la función de esa tecla.</string>
    <string name="remote_buttons_hold_note">La presión larga funciona cuando tu dispositivo pasa a la app el botón que mantienes presionado. Si en Configurar un botón nunca se detecta una presión larga, ese botón solo tiene función al presionar en este dispositivo.</string>
    <string name="remote_buttons_number_keys">Teclas numéricas</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = mitad, 0 = inicio</string>
    <string name="remote_buttons_added">Configurado en este dispositivo</string>
    <string name="remote_buttons_up_down_row">Mientras los controles están ocultos</string>
    <string name="remote_buttons_up_down_desc">Solo mientras los controles del reproductor están ocultos. Con los controles a la vista, Arriba y Abajo se mueven por ellos como siempre.</string>
    <string name="remote_buttons_learn_title">Configurar un botón</string>
    <string name="remote_buttons_learn_subtitle">Presiona el botón del control al que quieres dar una función. Mantenlo presionado para definir en su lugar su función al mantener presionado. Atrás cancela.</string>
    <string name="remote_buttons_learn_waiting">Esperando un botón…</string>
    <string name="remote_buttons_learn_let_go">Presión larga detectada. Suelta el botón.</string>
    <string name="remote_buttons_learn_nothing">Todavía no llegó nada. Algunos botones, como Inicio, el micrófono, el volumen y los botones de Netflix o YouTube, pertenecen a tu dispositivo y nunca llegan a la app. Si usas el control de tu TV, es posible que la TV no pase este botón al dispositivo. Prueba otro botón o libéralo con una app de reasignación como tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s: no se puede cambiar. OK, Izquierda, Derecha y Atrás siempre mantienen su función habitual, para que nadie se quede atascado en el reproductor. Presiona otro botón.</string>
    <string name="remote_buttons_learn_volume">El volumen sigue a cargo de tu dispositivo o TV. Presiona otro botón.</string>
    <string name="remote_buttons_press">Presionar</string>
